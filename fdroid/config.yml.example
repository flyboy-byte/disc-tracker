# Non-secret template. The real config.yml (gitignored, contains keystore passwords in
# plain text) is generated by `fdroid init` and then hand-edited for the fields below —
# everything else in the real file is fdroidserver's own default boilerplate/comments,
# not reproduced here. See README.md for the full init sequence.

sdk_path: /home/logan/Android/Sdk

repo_keyalias: repokey
keystore: /home/logan/projects/disc-tracker/fdroid/keystore.p12
# keystorepass / keypass: set by `fdroid init`, gitignored — never put real values here.

keydname: CN=, OU=, O=, L=, ST=, C=US

repo_url: https://fdroid.flyboybyte.com/fdroid/repo
repo_name: Logan Night's Apps
repo_description: >-
  Self-hosted F-Droid repo for flyboy-byte's Android apps. Every APK here is
  built and signed locally from the same source published on GitHub — no
  third-party build server, no proprietary blobs. See each app's own repo
  for full source and privacy documentation.

# Expo SDK 57's expo-router pulls web-only deps (vaul → @radix-ui/*) that declare a react-dom
# peer. This is a native (Android) app with no react-dom, so npm's strict peer check errors on an
# irrelevant conflict. Setting this makes `npm install`/`npm ci` deterministic and flag-free for
# everyone — dev, CI, and F-Droid's reproducible build — instead of relying on a remembered
# --legacy-peer-deps flag. This is NOT a pnpm hoisted-linker setting (which RESEARCH.md forbids);
# it only relaxes the peer-resolution strictness.
legacy-peer-deps=true
